{
  "name": "m5-rate-limits",
  "requests": [
    {
      "name": "login",
      "method": "POST",
      "path": "/api/collections/_superusers/auth-with-password",
      "body": "{\"identity\": \"admin@example.com\", \"password\": \"pass12345678\"}",
      "save": {
        "token": "token"
      }
    },
    {
      "name": "create-collection",
      "method": "POST",
      "path": "/api/collections",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"name\": \"rl\", \"type\": \"base\", \"listRule\": \"\", \"createRule\": \"\", \"fields\": [{\"name\": \"title\", \"type\": \"text\"}]}",
      "save": {
        "collectionId": "id"
      }
    },
    {
      "name": "patch-settings-star-list",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\": {\"enabled\": true, \"rules\": [{\"label\": \"*:list\", \"maxRequests\": 1, \"duration\": 60}]}}"
    },
    {
      "name": "list-guest-1",
      "method": "GET",
      "path": "/api/collections/rl/records"
    },
    {
      "name": "list-guest-2",
      "method": "GET",
      "path": "/api/collections/rl/records"
    },
    {
      "name": "list-super-bypass",
      "method": "GET",
      "path": "/api/collections/rl/records",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "patch-settings-name-list",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\": {\"enabled\": true, \"rules\": [{\"label\": \"rl:list\", \"maxRequests\": 2, \"duration\": 60}]}}"
    },
    {
      "name": "list-name-1",
      "method": "GET",
      "path": "/api/collections/rl/records"
    },
    {
      "name": "list-name-2",
      "method": "GET",
      "path": "/api/collections/rl/records"
    },
    {
      "name": "list-name-3",
      "method": "GET",
      "path": "/api/collections/rl/records"
    },
    {
      "name": "patch-settings-auth",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\": {\"enabled\": true, \"rules\": [{\"label\": \"*:auth\", \"maxRequests\": 1, \"duration\": 60, \"audience\": \"@auth\"}]}}"
    },
    {
      "name": "auth-guest-1",
      "method": "POST",
      "path": "/api/collections/rl/auth-with-password",
      "body": "{\"identity\": \"a@b.c\", \"password\": \"bad\"}"
    },
    {
      "name": "auth-guest-2",
      "method": "POST",
      "path": "/api/collections/rl/auth-with-password",
      "body": "{\"identity\": \"a@b.c\", \"password\": \"bad\"}"
    },
    {
      "name": "auth-auth-1",
      "method": "POST",
      "path": "/api/collections/rl/auth-with-password",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"identity\": \"a@b.c\", \"password\": \"bad\"}"
    },
    {
      "name": "auth-auth-2",
      "method": "POST",
      "path": "/api/collections/rl/auth-with-password",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"identity\": \"a@b.c\", \"password\": \"bad\"}"
    },
    {
      "name": "create-auth-collection",
      "method": "POST",
      "path": "/api/collections",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"name\": \"rlauth\", \"type\": \"auth\", \"listRule\": \"\", \"createRule\": \"\", \"fields\": [{\"name\": \"name\", \"type\": \"text\"}], \"passwordAuth\": {\"enabled\": true}}"
    },
    {
      "name": "create-auth-user",
      "method": "POST",
      "path": "/api/collections/rlauth/records",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"email\": \"u@example.com\", \"password\": \"pass12345678\", \"passwordConfirm\": \"pass12345678\"}"
    },
    {
      "name": "login-user",
      "method": "POST",
      "path": "/api/collections/rlauth/auth-with-password",
      "body": "{\"identity\": \"u@example.com\", \"password\": \"pass12345678\"}",
      "save": {
        "userToken": "token"
      }
    },
    {
      "name": "patch-settings-auth-user",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\": {\"enabled\": true, \"rules\": [{\"label\": \"*:auth\", \"maxRequests\": 1, \"duration\": 60, \"audience\": \"@auth\"}]}}"
    },
    {
      "name": "auth-user-1",
      "method": "POST",
      "path": "/api/collections/rlauth/auth-with-password",
      "headers": {
        "authorization": "{{userToken}}"
      },
      "body": "{\"identity\": \"u@example.com\", \"password\": \"bad\"}"
    },
    {
      "name": "auth-user-2",
      "method": "POST",
      "path": "/api/collections/rlauth/auth-with-password",
      "headers": {
        "authorization": "{{userToken}}"
      },
      "body": "{\"identity\": \"u@example.com\", \"password\": \"bad\"}"
    },
    {
      "name": "patch-settings-window",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\": {\"enabled\": true, \"rules\": [{\"label\": \"*:list\", \"maxRequests\": 1, \"duration\": 1}]}}"
    },
    {
      "name": "window-1",
      "method": "GET",
      "path": "/api/collections/rl/records"
    },
    {
      "name": "window-2",
      "method": "GET",
      "path": "/api/collections/rl/records",
      "delayMs": 1200
    },
    {
      "name": "patch-settings-prefix",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\": {\"enabled\": true, \"rules\": [{\"label\": \"POST /api/collections/\", \"maxRequests\": 1, \"duration\": 60}]}}"
    },
    {
      "name": "prefix-create-1",
      "method": "POST",
      "path": "/api/collections/rl/records",
      "body": "{\"title\": \"a\"}"
    },
    {
      "name": "prefix-create-2",
      "method": "POST",
      "path": "/api/collections/rl/records",
      "body": "{\"title\": \"b\"}"
    },
    {
      "name": "patch-settings-file",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\": {\"enabled\": true, \"rules\": [{\"label\": \"*:file\", \"maxRequests\": 1, \"duration\": 60}]}}"
    },
    {
      "name": "file-1",
      "method": "GET",
      "path": "/api/files/rl/abc/x.txt"
    },
    {
      "name": "file-2",
      "method": "GET",
      "path": "/api/files/rl/abc/x.txt"
    },
    {
      "name": "patch-settings-excluded",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\": {\"enabled\": true, \"rules\": [{\"label\": \"*:list\", \"maxRequests\": 1, \"duration\": 60}], \"excludedIPs\": [\"127.0.0.1\"]}}"
    },
    {
      "name": "excluded-1",
      "method": "GET",
      "path": "/api/collections/rl/records"
    },
    {
      "name": "excluded-2",
      "method": "GET",
      "path": "/api/collections/rl/records"
    }
  ]
}
