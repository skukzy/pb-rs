{
  "name": "m5-settings-tools",
  "requests": [
    {
      "name": "login",
      "method": "POST",
      "path": "/api/collections/_superusers/auth-with-password",
      "body": "{\"identity\": \"admin@example.com\", \"password\": \"pass12345678\"}",
      "save": {
        "token": "token"
      }
    },
    {
      "name": "email-unauth",
      "method": "POST",
      "path": "/api/settings/test/email",
      "body": "{\"email\": \"a@example.com\", \"template\": \"verification\"}"
    },
    {
      "name": "email-empty",
      "method": "POST",
      "path": "/api/settings/test/email",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{}"
    },
    {
      "name": "email-bad",
      "method": "POST",
      "path": "/api/settings/test/email",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"email\": \"nope\", \"template\": \"bogus\", \"collection\": \"bogus\"}"
    },
    {
      "name": "email-long",
      "method": "POST",
      "path": "/api/settings/test/email",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"email\": \"a@example.com\", \"template\": \"verification\", \"collection\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}"
    },
    {
      "name": "email-valid",
      "method": "POST",
      "path": "/api/settings/test/email",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"email\": \"a@example.com\", \"template\": \"verification\"}"
    },
    {
      "name": "email-valid-collection",
      "method": "POST",
      "path": "/api/settings/test/email",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"email\": \"a@example.com\", \"template\": \"otp\", \"collection\": \"users\"}"
    },
    {
      "name": "s3-unauth",
      "method": "POST",
      "path": "/api/settings/test/s3",
      "body": "{\"filesystem\": \"storage\"}"
    },
    {
      "name": "s3-empty",
      "method": "POST",
      "path": "/api/settings/test/s3",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{}"
    },
    {
      "name": "s3-bad",
      "method": "POST",
      "path": "/api/settings/test/s3",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"filesystem\": \"bogus\"}"
    },
    {
      "name": "s3-storage-disabled",
      "method": "POST",
      "path": "/api/settings/test/s3",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"filesystem\": \"storage\"}"
    },
    {
      "name": "s3-backups-disabled",
      "method": "POST",
      "path": "/api/settings/test/s3",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"filesystem\": \"backups\"}"
    },
    {
      "name": "apple-unauth",
      "method": "POST",
      "path": "/api/settings/apple/generate-client-secret",
      "body": "{}"
    },
    {
      "name": "apple-empty",
      "method": "POST",
      "path": "/api/settings/apple/generate-client-secret",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{}"
    },
    {
      "name": "apple-bad-lengths",
      "method": "POST",
      "path": "/api/settings/apple/generate-client-secret",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"clientId\": \"a\", \"teamId\": \"x\", \"keyId\": \"y\", \"privateKey\": \"-----BEGIN PRIVATE KEY-----\\nabc\\n-----END PRIVATE KEY-----\", \"duration\": 0}"
    },
    {
      "name": "apple-duration-min",
