{
  "name": "m3g-fields",
  "requests": [
    {
      "name": "login",
      "method": "POST",
      "path": "/api/collections/_superusers/auth-with-password",
      "body": "{\"identity\": \"admin@example.com\", \"password\": \"pass12345678\"}",
      "save": { "token": "token" }
    },
    {
      "name": "create-zrefs",
      "method": "POST",
      "path": "/api/collections",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"type\": \"base\", \"name\": \"zrefs\", \"fields\": [{\"name\": \"title\", \"type\": \"text\", \"required\": true}]}",
      "save": { "zrefsId": "id" }
    },
    {
      "name": "create-ztypes",
      "method": "POST",
      "path": "/api/collections",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"type\": \"base\", \"name\": \"ztypes\", \"fields\": [{\"name\": \"title\", \"type\": \"text\", \"required\": true, \"min\": 3, \"max\": 10, \"pattern\": \"^[a-z]+$\"}, {\"name\": \"code\", \"type\": \"text\"}, {\"name\": \"slug\", \"type\": \"text\", \"autogeneratePattern\": \"fixed\"}, {\"name\": \"num\", \"type\": \"number\", \"min\": 1, \"max\": 10, \"onlyInt\": true}, {\"name\": \"price\", \"type\": \"number\"}, {\"name\": \"flag\", \"type\": \"bool\"}, {\"name\": \"mail\", \"type\": \"email\", \"required\": true}, {\"name\": \"site\", \"type\": \"url\"}, {\"name\": \"when\", \"type\": \"date\"}, {\"name\": \"pick\", \"type\": \"select\", \"values\": [\"a\", \"b\"], \"maxSelect\": 1}, {\"name\": \"many\", \"type\": \"select\", \"values\": [\"x\", \"y\", \"z\"], \"maxSelect\": 2}, {\"name\": \"blob\", \"type\": \"json\"}, {\"name\": \"point\", \"type\": \"geoPoint\"}, {\"name\": \"ref\", \"type\": \"relation\", \"collectionId\": \"{{zrefsId}}\", \"maxSelect\": 1}, {\"name\": \"refs\", \"type\": \"relation\", \"collectionId\": \"{{zrefsId}}\", \"maxSelect\": 2}, {\"name\": \"attach\", \"type\": \"file\", \"maxSelect\": 1}], \"indexes\": [\"CREATE UNIQUE INDEX idx_ztypes_code ON ztypes (code)\"]}",
      "save": { "ztypesId": "id" }
    },
    {
      "name": "create-ref1",
      "method": "POST",
      "path": "/api/collections/zrefs/records",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"title\": \"one\"}",
      "save": { "ref1": "id" }
    },
    {
      "name": "create-ref2",
      "method": "POST",
      "path": "/api/collections/zrefs/records",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"title\": \"two\"}",
      "save": { "ref2": "id" }
    },
    {
      "name": "create-valid",
      "method": "POST",
      "path": "/api/collections/ztypes/records",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"title\": \"abc\", \"code\": \"c1\", \"num\": 5, \"price\": 1.5, \"flag\": true, \"mail\": \"a@b.co\", \"site\": \"https://example.com\", \"when\": \"2024-01-02 03:04:05.000Z\", \"pick\": \"a\", \"many\": [\"x\", \"y\"], \"blob\": {\"b\": 2, \"a\": [1, 2]}, \"point\": {\"lon\": 10, \"lat\": 20}, \"ref\": \"{{ref1}}\", \"refs\": [\"{{ref1}}\", \"{{ref2}}\"]}",
      "save": { "rid": "id" }
    },
    {
      "name": "get-valid",
      "method": "GET",
      "path": "/api/collections/ztypes/records/{{rid}}",
      "headers": { "authorization": "{{token}}" }
