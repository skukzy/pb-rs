{
  "name": "m5-batch",
  "requests": [
    {
      "name": "login",
      "method": "POST",
      "path": "/api/collections/_superusers/auth-with-password",
      "body": "{\"identity\": \"admin@example.com\", \"password\": \"pass12345678\"}",
      "save": {
        "token": "token"
      }
    },
    {
      "name": "enable-batch",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"batch\": {\"enabled\": true, \"maxRequests\": 50, \"timeout\": 3}}"
    },
    {
      "name": "create-collection",
      "method": "POST",
      "path": "/api/collections",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"name\": \"batchprobe\", \"type\": \"base\", \"listRule\": \"\", \"viewRule\": \"\", \"createRule\": \"\", \"updateRule\": \"\", \"deleteRule\": \"\", \"fields\": [{\"name\": \"title\", \"type\": \"text\", \"required\": true}]}"
    },
    {
      "name": "success",
      "method": "POST",
      "path": "/api/batch",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"requests\": [{\"method\": \"POST\", \"url\": \"/api/collections/batchprobe/records\", \"body\": {\"title\": \"batch1\"}}, {\"method\": \"POST\", \"url\": \"/api/collections/batchprobe/records\", \"body\": {\"title\": \"batch2\"}}, {\"method\": \"PUT\", \"url\": \"/api/collections/batchprobe/records\", \"body\": {\"title\": \"batch3\"}}]}",
      "save": {
        "id0": "0.body.id",
        "id1": "1.body.id"
      }
    },
    {
      "name": "failure-rollback",
      "method": "POST",
      "path": "/api/batch",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"requests\": [{\"method\": \"POST\", \"url\": \"/api/collections/batchprobe/records\", \"body\": {\"title\": \"rollback1\"}}, {\"method\": \"POST\", \"url\": \"/api/collections/batchprobe/records\", \"body\": {\"title\": \"rollback2\"}}, {\"method\": \"POST\", \"url\": \"/api/collections/batchprobe/records\", \"body\": {\"title\": \"\"}}]}"
    },
    {
      "name": "rollback-count",
      "method": "GET",
      "path": "/api/collections/batchprobe/records",
      "query": {
        "filter": "title~'rollback'"
      },
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "unknown-action",
      "method": "POST",
      "path": "/api/batch",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"requests\": [{\"method\": \"GET\", \"url\": \"/api/health\"}]}"
    },
    {
      "name": "per-request-validation",
      "method": "POST",
      "path": "/api/batch",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"requests\": [{}, {\"method\": \"GET\", \"url\": \"/valid\"}, {\"method\": \"invalid\", \"url\": \"/valid\"}, {\"method\": \"POST\", \"url\": \"\"}]}"
    },
    {
      "name": "too-many",
      "method": "POST",
      "path": "/api/batch",
      "headers": {
        "authorization": "{{token}}"
      },
