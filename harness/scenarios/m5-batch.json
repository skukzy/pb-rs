    },
    {
      "name": "delete",
      "method": "POST",
      "path": "/api/batch",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"requests\": [{\"method\": \"DELETE\", \"url\": \"/api/collections/batchprobe/records/{{id0}}\"}]}"
    },
    {
      "name": "list-after",
      "method": "GET",
      "path": "/api/collections/batchprobe/records",
      "query": {
        "sort": "title"
      },
      "headers": {
        "authorization": "{{token}}"
      }
    }
  ]
}
