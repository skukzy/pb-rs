{
  "name": "m2b-settings",
  "requests": [
    {
      "name": "login",
      "method": "POST",
      "path": "/api/collections/_superusers/auth-with-password",
      "body": "{\"identity\":\"admin@example.com\",\"password\":\"pass12345678\"}",
      "save": {
        "token": "token"
      }
    },
    {
      "name": "settings-before",
      "method": "GET",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "patch-anon",
      "method": "PATCH",
      "path": "/api/settings",
      "body": "{\"meta\":{\"appName\":\"Anon\"}}"
    },
    {
      "name": "patch-app-name",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"meta\":{\"appName\":\"My App\"}}"
    },
    {
      "name": "patch-empty-body",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "patch-empty-object",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{}"
    },
    {
      "name": "patch-nested-merge",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"backups\":{\"s3\":{\"bucket\":\"mybucket\",\"secret\":\"s3cr3t\"}},\"s3\":{\"secret\":\"tops3cr3t\"}}"
    },
    {
      "name": "settings-after-merge",
      "method": "GET",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "patch-rules-replaced",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\":{\"rules\":[{\"label\":\"*:auth\",\"maxRequests\":9,\"duration\":9}],\"excludedIPs\":[\"127.0.0.1\",\"10.0.0.0/8\"]}}"
    },
    {
      "name": "patch-unknown-keys",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"nope\":1,\"meta\":{\"unknown\":true,\"appName\":\"Keep\"}}"
    },
    {
      "name": "patch-bad-url",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"meta\":{\"appURL\":\"nope\"}}"
    },
    {
      "name": "patch-bad-email",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"meta\":{\"senderAddress\":\"nope\"}}"
    },
    {
      "name": "patch-bad-color",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"meta\":{\"accentColor\":\"red\"}}"
    },
    {
      "name": "patch-bad-hex-color",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"meta\":{\"accentColor\":\"#gggggg\"}}"
    },
    {
      "name": "patch-long-app-name",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"meta\":{\"appName\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}"
    },
    {
      "name": "patch-required-meta",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"meta\":null}"
    },
    {
      "name": "patch-null-scalar",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"meta\":{\"hideControls\":null},\"logs\":{\"maxDays\":null}}"
    },
    {
      "name": "patch-s3-enabled",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"s3\":{\"enabled\":true}}"
    },
    {
      "name": "patch-s3-bad-endpoint",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"s3\":{\"endpoint\":\"nope\"}}"
    },
    {
      "name": "patch-smtp-host",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"smtp\":{\"host\":\"-bad\",\"authMethod\":\"NOPE\"}}"
    },
    {
      "name": "patch-bad-cron",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"backups\":{\"cron\":\"nope\"}}"
    },
    {
      "name": "patch-cron-max-keep",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"backups\":{\"cron\":\"* * * * *\",\"cronMaxKeep\":0}}"
    },
    {
      "name": "patch-negative-logs",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"logs\":{\"maxDataSize\":-1}}"
    },
    {
      "name": "patch-bad-ips",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"superuserIPs\":[\"127.0.0.1\",\"nope\"],\"rateLimits\":{\"excludedIPs\":[\"\"]}}"
    },
    {
      "name": "patch-rule-conflict",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\":{\"rules\":[{\"label\":\"*:auth\",\"maxRequests\":1,\"duration\":1},{\"label\":\"*:auth\",\"maxRequests\":2,\"duration\":2}]}}"
    },
    {
      "name": "patch-rule-element-first",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\":{\"rules\":[{\"label\":\"*:auth\",\"maxRequests\":1,\"duration\":1},{\"label\":\"*:auth\",\"maxRequests\":0,\"duration\":1}]}}"
    },
    {
      "name": "patch-rule-bad-label",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\":{\"rules\":[{\"label\":\"bad label\",\"maxRequests\":1,\"duration\":1}]}}"
    },
    {
      "name": "patch-enabled-empty-rules",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"rateLimits\":{\"enabled\":true,\"rules\":[]}}"
    },
    {
      "name": "patch-type-mismatch",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{\"meta\":{\"appName\":123}}"
    },
    {
      "name": "patch-bad-json",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "{"
    },
    {
      "name": "patch-null-body",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      },
      "body": "null"
    },
    {
      "name": "patch-text-plain",
      "method": "PATCH",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}",
        "content-type": "text/plain"
      },
      "body": "{\"meta\":{\"appName\":\"Plain\"}}"
    },
    {
      "name": "settings-after",
      "method": "GET",
      "path": "/api/settings",
      "headers": {
        "authorization": "{{token}}"
      }
    }
  ]
}
