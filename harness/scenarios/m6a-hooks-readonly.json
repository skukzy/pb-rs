{
  "name": "m6a-hooks-readonly",
  "requests": [
    {
      "name": "login",
      "method": "POST",
      "path": "/api/collections/_superusers/auth-with-password",
      "body": "{\"identity\": \"admin@example.com\", \"password\": \"pass12345678\"}",
      "save": {
        "token": "token"
      }
    },
    {
      "name": "list-records",
      "method": "GET",
      "path": "/api/collections/hooktest/records",
      "headers": {
        "authorization": "{{token}}"
      },
      "query": {
        "sort": "title",
        "perPage": "100"
      },
      "save": {
        "firstId": "items.0.id"
      }
    },
    {
      "name": "view-record",
      "method": "GET",
      "path": "/api/collections/hooktest/records/{{firstId}}",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "find-viewreject",
      "method": "GET",
      "path": "/api/collections/hooktest/records",
      "headers": {
        "authorization": "{{token}}"
      },
      "query": {
        "filter": "title='viewreject'"
      },
      "save": {
        "viewRejectId": "items.0.id"
      }
    },
    {
      "name": "view-reject",
      "method": "GET",
      "path": "/api/collections/hooktest/records/{{viewRejectId}}",
      "headers": {
        "authorization": "{{token}}"
      }
    },
    {
      "name": "list-reject",
      "method": "GET",
      "path": "/api/collections/hooktest/records",
      "headers": {
        "authorization": "{{token}}"
      },
      "query": {
        "filter": "title='listreject'"
      }
    },
    {
      "name": "list-error-collection",
      "method": "GET",
      "path": "/api/collections/reqtest/records",
      "headers": {
        "authorization": "{{token}}"
      }
    }
  ]
}
