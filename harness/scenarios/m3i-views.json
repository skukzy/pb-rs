{
  "name": "m3i-views",
  "requests": [
    {
      "name": "login",
      "method": "POST",
      "path": "/api/collections/_superusers/auth-with-password",
      "body": "{\"identity\": \"admin@example.com\", \"password\": \"pass12345678\"}",
      "save": { "token": "token" }
    },
    {
      "name": "create-vsrc",
      "method": "POST",
      "path": "/api/collections",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"type\": \"base\", \"name\": \"vsrc\", \"fields\": [{\"name\": \"title\", \"type\": \"text\"}, {\"name\": \"num\", \"type\": \"number\"}, {\"name\": \"flag\", \"type\": \"bool\"}, {\"name\": \"blob\", \"type\": \"json\"}, {\"name\": \"dt\", \"type\": \"date\"}, {\"name\": \"pick\", \"type\": \"select\", \"values\": [\"a\", \"b\"], \"maxSelect\": 1}, {\"name\": \"secret\", \"type\": \"text\", \"hidden\": true}]}"
    },
    {
      "name": "rec1",
      "method": "POST",
      "path": "/api/collections/vsrc/records",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"id\": \"vsrc00000000001\", \"title\": \"t1\", \"num\": 1, \"flag\": true, \"blob\": {\"i\": 1}, \"dt\": \"2024-01-02 03:04:05.000Z\", \"pick\": \"a\", \"secret\": \"s1\"}"
    },
    {
      "name": "rec2",
      "method": "POST",
      "path": "/api/collections/vsrc/records",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"id\": \"vsrc00000000002\", \"title\": \"t2\", \"num\": 2, \"flag\": false, \"blob\": {\"i\": 2}, \"dt\": \"2024-01-03 03:04:05.000Z\", \"pick\": \"b\", \"secret\": \"s2\"}"
    },
    {
      "name": "rec3",
      "method": "POST",
      "path": "/api/collections/vsrc/records",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"id\": \"vsrc00000000003\", \"title\": \"t3\", \"num\": 3, \"flag\": true, \"blob\": {\"i\": 3}, \"dt\": \"2024-01-04 03:04:05.000Z\", \"pick\": \"a\", \"secret\": \"s3\"}"
    },
    {
      "name": "dry-simple",
      "method": "POST",
      "path": "/api/collections/meta/dry-run-view",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"query\": \"SELECT id, title, num, flag, blob FROM vsrc\"}"
    },
    {
      "name": "dry-hidden",
      "method": "POST",
      "path": "/api/collections/meta/dry-run-view",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"query\": \"SELECT id, title, secret FROM vsrc\"}"
    },
    {
      "name": "dry-aggr",
      "method": "POST",
      "path": "/api/collections/meta/dry-run-view",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"query\": \"SELECT id, count(*) as cnt, total(num) as tot, CAST(num AS text) as ntext, CAST(flag AS int) as nint, CAST(title AS bool) as b FROM vsrc GROUP BY id ORDER BY id\"}"
    },
    {
      "name": "dry-cast-real",
      "method": "POST",
      "path": "/api/collections/meta/dry-run-view",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"query\": \"SELECT id, CAST(num AS real) as r FROM vsrc ORDER BY id\"}"
    },
    {
      "name": "dry-alias",
      "method": "POST",
      "path": "/api/collections/meta/dry-run-view",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"query\": \"SELECT id, title AS t, vsrc.num AS n FROM vsrc ORDER BY id\"}"
    },
    {
      "name": "dry-int-id",
      "method": "POST",
      "path": "/api/collections/meta/dry-run-view",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"query\": \"SELECT (ROW_NUMBER() OVER()) as id, title FROM vsrc ORDER BY title\"}"
    },
    {
      "name": "dry-quote",
      "method": "POST",
      "path": "/api/collections/meta/dry-run-view",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"query\": \"SELECT id, title FROM vsrc WHERE title != 'a;b' ORDER BY id\"}"
    },
    {
      "name": "dry-wild",
      "method": "POST",
      "path": "/api/collections/meta/dry-run-view",
      "headers": { "authorization": "{{token}}" },
      "body": "{\"query\": \"SELECT * FROM vsrc\"}"
    },
    {
      "name": "dry-noid",
      "method": "POST",
